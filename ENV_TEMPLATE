# TP-Link Cloud API Credentials
TPLINK_CLIENT_ID=your-client-id
TPLINK_CLIENT_SECRET=your-client-secret
TPLINK_API_KEY=your-api-key
TPLINK_REFRESH_TOKEN=your-refresh-token

# PostgreSQL/TimescaleDB Connection
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=gos_rem
POSTGRES_USER=gos
POSTGRES_PASSWORD=change-me-in-production

# Collector Settings
POLL_INTERVAL=30
# Optional: force concurrent device API calls (1–32). When set, overrides parallel_workers in collector_control.json.
# COLLECTOR_PARALLEL_WORKERS=8
LOG_LEVEL=INFO

# Admin UI Settings
ADMIN_PORT=7001

# Admin UI Basic Auth (optional)
# If both are set, HTTP Basic Auth will be required for the UI and APIs
ADMIN_BASIC_USER=
ADMIN_BASIC_PASSWORD=

# NAS Storage Path (for WRX - all data stored on NAS instead of SD card)
# Set this to your NAS mount point, e.g., /mnt/nas/stats or /media/nas/stats
NAS_DATA_PATH=/home/pi/nas/gos_stats