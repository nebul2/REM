{
  "dashboard": {
    "title": "GOS Remote Energy Measurement (REM)",
    "description": "Real-time power consumption monitoring from TP-Link Tapo P110 devices",
    "tags": ["energy", "power", "gos", "tplink"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    },
    "templating": {
      "list": [
        {
          "name": "device_filter",
          "type": "query",
          "label": "Device Filter",
          "datasource": {
            "type": "influxdb",
            "uid": "InfluxDB"
          },
          "query": {
            "query": "from(bucket: \"rem\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"gos_rem\")\n  |> keep(columns: [\"alias\"])\n  |> distinct(column: \"alias\")\n  |> sort()\n  |> map(fn: (r) => ({_value: r.alias}))",
            "refId": "StandardVariableQuery"
          },
          "current": {
            "selected": false,
            "text": "All",
            "value": "$__all"
          },
          "options": [],
          "multi": true,
          "includeAll": true,
          "allValue": null,
          "refresh": 1,
          "regex": "",
          "skipUrlSync": false,
          "sort": 1
        },
        {
          "name": "interval",
          "type": "interval",
          "label": "Aggregation Interval",
          "current": {
            "selected": true,
            "text": "1m",
            "value": "1m"
          },
          "options": [
            {"text": "10s", "value": "10s", "selected": false},
            {"text": "30s", "value": "30s", "selected": false},
            {"text": "1m", "value": "1m", "selected": true},
            {"text": "5m", "value": "5m", "selected": false},
            {"text": "15m", "value": "15m", "selected": false},
            {"text": "1h", "value": "1h", "selected": false}
          ],
          "query": "10s,30s,1m,5m,15m,1h",
          "refresh": 1,
          "skipUrlSync": false
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Total Power Consumption (Watts)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 8, "x": 0, "y": 0},
        "targets": [
          {
            "datasource": {"type": "influxdb", "uid": "InfluxDB"},
            "query": "from(bucket: \"rem\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"gos_rem\")\n  |> filter(fn: (r) => r._field == \"powerWatts\")\n  |> group()\n  |> mean()\n  |> group()\n  |> sum()",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "W",
            "decimals": 1,
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 1000, "color": "yellow"},
                {"value": 5000, "color": "red"}
              ]
            }
          }
        },
        "options": {
          "graphMode": "none",
          "colorMode": "value",
          "orientation": "auto"
        }
      },
      {
        "id": 2,
        "title": "Active Devices",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
        "targets": [
          {
            "datasource": {"type": "influxdb", "uid": "InfluxDB"},
            "query": "from(bucket: \"rem\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"gos_rem\")\n  |> filter(fn: (r) => r._field == \"powerWatts\")\n  |> group(columns: [\"alias\"])\n  |> last()\n  |> count()",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "options": {
          "graphMode": "none",
          "colorMode": "value"
        }
      },
      {
        "id": 3,
        "title": "Power Consumption Over Time",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
        "targets": [
          {
            "datasource": {"type": "influxdb", "uid": "InfluxDB"},
            "query": "from(bucket: \"rem\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"gos_rem\")\n  |> filter(fn: (r) => r._field == \"powerWatts\")\n  |> filter(fn: (r) => if \"${device_filter:json}\" == \"\" or \"${device_filter:json}\" == \"All\" then true else contains(value: r.alias, set: ${device_filter:json}))\n  |> aggregateWindow(every: ${interval:raw}, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "W",
            "decimals": 1,
            "color": {"mode": "palette-classic"},
            "custom": {
              "axisLabel": "Power (W)",
              "axisPlacement": "auto",
              "drawStyle": "line",
              "fillOpacity": 10,
              "gradientMode": "none",
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 5,
              "showPoints": "never",
              "spanNulls": false
            }
          }
        },
        "options": {
          "tooltip": {"mode": "multi"},
          "legend": {
            "calcs": ["lastNotNull", "max", "mean"],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          }
        }
      },
      {
        "id": 4,
        "title": "Top Power Consumers (Last 10 minutes)",
        "type": "bargauge",
        "gridPos": {"h": 10, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "datasource": {"type": "influxdb", "uid": "InfluxDB"},
            "query": "from(bucket: \"rem\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"gos_rem\")\n  |> filter(fn: (r) => r._field == \"powerWatts\")\n  |> filter(fn: (r) => if \"${device_filter:json}\" == \"\" or \"${device_filter:json}\" == \"All\" then true else contains(value: r.alias, set: ${device_filter:json}))\n  |> group(columns: [\"alias\"])\n  |> mean()\n  |> sort(columns: [\"_value\"], desc: true)\n  |> limit(n: 15)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "W",
            "decimals": 1,
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 50, "color": "yellow"},
                {"value": 100, "color": "orange"},
                {"value": 200, "color": "red"}
              ]
            }
          }
        },
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true
        }
      },
      {
        "id": 5,
        "title": "Current Power by Device",
        "type": "table",
        "gridPos": {"h": 10, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "datasource": {"type": "influxdb", "uid": "InfluxDB"},
            "query": "from(bucket: \"rem\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"gos_rem\")\n  |> filter(fn: (r) => r._field == \"powerWatts\")\n  |> filter(fn: (r) => if \"${device_filter:json}\" == \"\" or \"${device_filter:json}\" == \"All\" then true else contains(value: r.alias, set: ${device_filter:json}))\n  |> group(columns: [\"alias\"])\n  |> last()\n  |> sort(columns: [\"_value\"], desc: true)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "displayMode": "auto"
            },
            "mappings": []
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "_value"},
              "properties": [
                {"id": "unit", "value": "W"},
                {"id": "decimals", "value": 1},
                {"id": "displayName", "value": "Power (W)"}
              ]
            }
          ]
        },
        "options": {
          "showHeader": true,
          "sortBy": [
            {
              "displayName": "_value",
              "desc": true
            }
          ]
        }
      }
    ],
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "links": [],
    "liveNow": false,
    "weekStart": ""
  }
}

